 pub type AxiAddress = u64;
-pub type RctlDepth = u8;
+pub type RctlDepth = u16;
+
+/// Which `m_axi` timing model to use, chosen once per process from the
+/// `LSIM_AXI_MODEL` environment variable (`v2021`, the default, or `v2023`).
+///
+/// `v2021` is the original LightningSim model, calibrated against the Vitis
+/// HLS 2021.1 adapter. `v2023` models the Vitis HLS 2023.2 adapter and cosim
+/// memory (measured on cosim VCDs, see cosim/lsim/README.md):
+/// - reads: bursts split at `max_read_burst_length` and 4 KB, a read credit
+///   of `num_read_outstanding` bursts released when the kernel has consumed
+///   a burst;
+/// - writes: one AW node per burst (bus AW time), fed by the kernel's last
+///   write of the burst, the write request, the previous burst (bursts leave
+///   serially), the one-burst throttle FIFO and the write credit of
+///   `num_write_outstanding` B responses; kernel writes stall on a buffer of
+///   `WBUFF_DEPTH` + throttle FIFO beats; the write response is the last
+///   burst's B response.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum AxiModel {
+    V2021,
+    V2023,
+}
+
+/// Number of v2023 delay constants.
+pub const AXI_NUM_CONSTANTS: usize = 9;
+
+/// Names of the v2023 delay constants, in `LSIM_AXI_CONST` order.
+pub const AXI_CONSTANT_NAMES: [&str; AXI_NUM_CONSTANTS] =
+    ["r0", "r1", "wa", "wq", "wf", "wc", "wk", "wb", "wl"];
+
+/// Default v2023 constants, fitted against Vitis HLS 2023.2 cosim.
+pub const AXI_V2023_DEFAULT_CONSTANTS: [ClockCycle; AXI_NUM_CONSTANTS] = [11, 7, 5, 10, 3, 5, 1, 4, 0];
+
+/// Delay constants of the v2023 model, in cycles (`L` = interface latency).
+/// The edges read them by index (see [axi_constant]); this struct names them.
+/// Overridable as `LSIM_AXI_CONST=r0,r1,wa,wq,wf,wc,wk,wb,wl`.
+#[derive(Clone, Copy, Debug)]
+#[allow(dead_code)]
+pub struct AxiConstants {
+    /// read request -> first read of the request: L + r0
+    pub r0: ClockCycle,
+    /// last read of burst j -> first read of burst j + num_read_outstanding: L + r1
+    pub r1: ClockCycle,
+    /// kernel's last write of burst j -> AW(j): wa
+    pub wa: ClockCycle,
+    /// write request -> AW of each of its bursts: wq + len(j)
+    pub wq: ClockCycle,
+    /// AW of the burst holding beat e(j) - throttle depth -> AW(j): wf + offset of that beat
+    pub wf: ClockCycle,
+    /// AW(j - num_write_outstanding) -> AW(j): len + L + 1 + wc + len(j) (B response, then refill)
+    pub wc: ClockCycle,
+    /// AW of the burst holding beat i - (WBUFF + throttle depth) -> kernel write i: wk + offset
+    pub wk: ClockCycle,
+    /// AW(last burst of a request) -> write response: len + L + 1 + wb
+    pub wb: ClockCycle,
+    /// kernel's last write of a request -> write response: L + wl (lower bound only)
+    pub wl: ClockCycle,
+}
+
+pub struct AxiGlobals {
+    pub model: AxiModel,
+}
+
+static AXI_CONSTANTS: [std::sync::atomic::AtomicU64; AXI_NUM_CONSTANTS] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; AXI_NUM_CONSTANTS];
+
+pub fn axi_globals() -> &'static AxiGlobals {
+    static GLOBALS: std::sync::OnceLock<AxiGlobals> = std::sync::OnceLock::new();
+    GLOBALS.get_or_init(|| {
+        let model = match std::env::var("LSIM_AXI_MODEL").as_deref() {
+            Ok("v2023") => AxiModel::V2023,
+            _ => AxiModel::V2021,
+        };
+        let mut c = AXI_V2023_DEFAULT_CONSTANTS;
+        if let Ok(s) = std::env::var("LSIM_AXI_CONST") {
+            for (slot, v) in c.iter_mut().zip(s.split(',')) {
+                if let Ok(v) = v.trim().parse() {
+                    *slot = v;
+                }
+            }
+        }
+        store_axi_constants(&c);
+        AxiGlobals { model }
+    })
+}
+
+fn store_axi_constants(c: &[ClockCycle]) {
+    for (slot, v) in AXI_CONSTANTS.iter().zip(c) {
+        slot.store(*v, std::sync::atomic::Ordering::Relaxed);
+    }
+}
+
+/// One v2023 delay constant by index (see [AXI_CONSTANT_NAMES]).
+pub fn axi_constant(index: u8) -> ClockCycle {
+    axi_globals();
+    AXI_CONSTANTS[index as usize].load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// The current v2023 delay constants (initialised from `LSIM_AXI_CONST`).
+pub fn axi_constants() -> AxiConstants {
+    let c = |i| axi_constant(i);
+    AxiConstants {
+        r0: c(0),
+        r1: c(1),
+        wa: c(2),
+        wq: c(3),
+        wf: c(4),
+        wc: c(5),
+        wk: c(6),
+        wb: c(7),
+        wl: c(8),
+    }
+}
+
+/// Override v2023 delay constants for later `execute` calls (used to fit
+/// them without rebuilding the simulation graph): a list in
+/// [AXI_CONSTANT_NAMES] order; missing trailing entries keep their value.
+#[pyfunction]
+pub fn set_axi_constants(values: Vec<ClockCycle>) {
+    axi_globals();
+    store_axi_constants(&values);
+}
+
+/// Whether v2023 is active and the current constants by name.
+#[pyfunction]
+pub fn get_axi_model() -> (bool, Vec<(String, ClockCycle)>) {
+    (
+        axi_v2023(),
+        AXI_CONSTANT_NAMES
+            .iter()
+            .enumerate()
+            .map(|(i, n)| (n.to_string(), axi_constant(i as u8)))
+            .collect(),
+    )
+}
+
+pub fn axi_v2023() -> bool {
+    axi_globals().model == AxiModel::V2023
+}
+
+/// Static per-interface adapter configuration (from the generated
+/// `<top>_<bundle>_m_axi` instance), used by the v2023 model.
+#[derive(Clone, Copy, Debug)]
+pub struct AxiConfig {
+    pub read_burst_beats: u64,
+    pub read_outstanding: RctlDepth,
+    pub write_burst_beats: u64,
+    pub write_outstanding: usize,
+    pub write_buffer_beats: usize,
+}
+
+impl Default for AxiConfig {
+    fn default() -> Self {
+        // Vitis HLS 2023.2 defaults: 16-beat bursts, 16 outstanding.
+        AxiConfig {
+            read_burst_beats: 16,
+            read_outstanding: 16,
+            write_burst_beats: 16,
+            write_outstanding: 16,
+            write_buffer_beats: 16,
+        }
+    }
+}
+
+/// Split a request of `count` beats of `increment` bytes starting at `offset`
+/// into AXI bursts the way the 2023.2 adapter does: never crossing a 4 KB
+/// boundary and at most `max_beats` beats each.
+pub fn split_bursts(offset: AxiAddress, increment: AxiAddress, count: u32, max_beats: u64) -> Vec<u32> {
+    let mut sizes = Vec::new();
+    let mut addr = offset;
+    let mut remaining: u64 = count.into();
+    let increment = increment.max(1);
+    let max_beats = max_beats.max(1);
+    while remaining > 0 {
+        let to_boundary = ((4096 - addr % 4096) / increment).max(1);
+        let n = remaining.min(max_beats).min(to_boundary);
+        sizes.push(n as u32);
+        addr += n * increment;
+        remaining -= n;
+    }
+    sizes
+}
 
