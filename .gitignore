# ---------------------------------------------------------------------------
# Flash experiment artifacts — dual-use branch (PC2 vLLM + team commercial API)
#
# IGNORE: per-run directory trees (matrix.json, per-bench HLS cells, cosim).
# KEEP (committable): summary docs directly under artifacts/pc2/ or
#   artifacts/flash_api/  e.g. flash_top5_comparison.tex, *.md tables.
# ---------------------------------------------------------------------------
artifacts/pc2/*/
artifacts/flash_api/*/
# PC2 supervised-session state (Slurm job ids, LLM endpoint, watch logs)
artifacts/pc2/sessions/
artifacts/pc2/session.json
artifacts/pc2/llm_endpoint.json
artifacts/pc2/watch.log

# Slurm / batch session noise (PC2 compute + GPU workers)
nohup.out
nohup*.log
**/nohup*.log
slurm-*.out
slurm-*.err
artifacts/pc2/slurm-*
artifacts/pc2/*_stamp.txt
