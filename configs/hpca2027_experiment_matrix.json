    "primary_profile": "hpca2027_reference_blind",
    "oracle_profile": "legacy_oracle_reference_guided",
    "notes": [
      "Every primary and replication cell is reference-blind. Expert sources and metrics are offline evaluation artifacts only.",
      "The oracle campaign is a separately labelled upper bound and must never be pooled with the primary results.",
      "All 132 rows have executable runner mappings; launch remains gated on immutable model and skill identities."
    ]
  },
  "target": {
    "toolchain": "Vitis HLS 2023.2",
