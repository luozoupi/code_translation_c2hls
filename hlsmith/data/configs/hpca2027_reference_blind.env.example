# One model and one immutable model revision per invocation.  Copy this file,
# fill in the revision, and source it before running run_agentic_sweep.py.
export C2HLS_SWEEP_PROFILE=hpca2027_reference_blind
export C2HLS_SWEEP_MODELS=qwen3.6-27b
export C2HLS_MODEL_REVISION=REPLACE_WITH_COMMIT_OR_WEIGHTS_SHA256

# The controller records these values in every result and its fingerprint.
export C2HLS_LLM_TEMPERATURE=0.2
export C2HLS_LLM_TOP_P=0.95
export C2HLS_LLM_SEED=0
export C2HLS_MAX_COMPLETION_TOKENS=8192
export C2HLS_FEEDBACK_LLM=0
export C2HLS_REFERENCE_CACHE_DIR=artifacts/reference_validation_cache

# Post-route implementation is a separate five-winner validation campaign,
# not part of the matched 132-cell search matrix.
export C2HLS_SWEEP_HW_EMU=0
export C2HLS_HW_EMU_FINAL=0

# Matched paper budget.  The controller must enforce the total synthesis cap;
# candidates/attempts are retained as per-action safety bounds.
export C2HLS_SYNTHESIS_EVAL_BUDGET=5
export C2HLS_LLM_CANDIDATE_BUDGET=5
export C2HLS_SWEEP_CANDIDATES_PER_STEP=5
export C2HLS_SWEEP_ATTEMPTS_PER_CANDIDATE=5

# Every candidate is golden-checked before consuming synthesis budget.  Only
# the feasible selected winner runs RTL cosim, which is forced even when old
# benchmark metadata said generated cosim was unsupported.
export C2HLS_CORRECTNESS_BEFORE_SYNTH=1
export C2HLS_FEASIBILITY_SELECTION=1
export C2HLS_DISABLE_CORRECTNESS_REPAIR=0
export C2HLS_SYNTH_REVERT_THRESHOLD=0
export C2HLS_PHASE5_LLM_RETRY=0
export C2HLS_CPU_GOLDEN_TIMEOUT=180
export C2HLS_COSIM_SELECTED_ONLY=1
export C2HLS_FORCE_SELECTED_COSIM=1
export C2HLS_COSIM_REQUIRED=0
export C2HLS_REFERENCE_COSIM=0
export C2HLS_REFERENCE_COSIM_SELECTED_ONLY=1
export C2HLS_REFERENCE_COSIM_BASELINE=1

# Use "off" or "on" in separate invocations.  The paper profile always
# disables persistence and online statistics, including for skill_on.
export C2HLS_SWEEP_SKILL_MODES=off
# Required for skill_on; obtain the aggregate SHA-256 from
# evaluation_repro.skill_snapshot_manifest(REPO)["sha256"].
export C2HLS_SKILL_LIBRARY_PATH=REPLACE_WITH_FROZEN_SKILLS_JSON
export C2HLS_SKILL_SNAPSHOT_SHA256=REPLACE_WITH_FROZEN_SKILL_SNAPSHOT_SHA256
export C2HLS_SWEEP_RESUME=1
export C2HLS_PART=xcu280-fsvh2892-2L-e
export C2HLS_CLOCK_NS=3.33
export C2HLS_VITIS_VERSION=2023.2
export C2HLS_VITIS_SETTINGS=/path/to/Xilinx/Vitis/2023.2/settings64.sh
