diff --git a/backend/lightningsim/frp.py b/backend/lightningsim/frp.py
index 17fb29934..706b150b2 100644
--- a/backend/lightningsim/frp.py
+++ b/backend/lightningsim/frp.py
@@ -14,6 +14,11 @@ Three differences from a stall pipeline, read from sol/syn/verilog and checked a
    chain, which every later read stall would push back.
 
 LSIM_FRP=0 turns all three off.
+
+Polled reads (`if (!s.empty()) s.read()`, nbreadreq) in a stall pipeline behave like 3 on the input side: the read is
+predicated on the poll, so an empty input issues a bubble and the iterations in flight go on (the C trace never sees a
+failed poll, so LightningSim would otherwise treat the read as blocking and freeze them). A full output still freezes
+the whole pipeline, so those writes are anchored with anchor_freeze. LSIM_POLL=0 turns this off.
 """
 
 import os
@@ -111,6 +116,14 @@ def frp_params(solution_dir: Path, fifos: Iterable) -> Tuple[Dict[int, int], Dic
     return extra, depths
 
 
+def pipeline_polls(function, pipeline) -> bool:
+    """Whether `pipeline` checks a FIFO with empty() (nbreadreq) before reading it."""
+    if os.environ.get("LSIM_POLL", "1") == "0":
+        return False
+    return any(ins.opcode == "nbreadreq" for bb in function.ordered_basic_blocks if bb.pipeline == pipeline
+               for ins in bb)
+
+
 def fifo_read_end(function, pipeline) -> int:
     """Latest static stage at which `function` reads a FIFO inside `pipeline` (the FRP issue anchor)."""
     best = -1
