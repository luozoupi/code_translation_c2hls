   "-o",
   "autosa_mm.xclbin",
   "--temp_dir",
   "/scratch/hpc-prf-llmfpga/asa582/projects/tmp/c2hls/xclbin_ladder_agent_r2_L3_63818674/_x_l",
   "--log_dir",
   "/scratch/hpc-prf-llmfpga/asa582/projects/tmp/c2hls/xclbin_ladder_agent_r2_L3_63818674/logs_l",
   "--report_dir",
   "/scratch/hpc-prf-llmfpga/asa582/projects/tmp/c2hls/xclbin_ladder_agent_r2_L3_63818674/reports_l"
  ],
  "iniFiles": [
   {
    "path": "/scratch/hpc-prf-llmfpga/asa582/projects/tmp/c2hls/xclbin_ladder_agent_r2_L3_63818674/link.cfg",
    "content": "# v++ --link config for autosa_mm (agent ladder r2 L3), xilinx_u280_gen3x16_xdma_1_202211_1, 300 MHz default kernel clock.\n[connectivity]\nnk=autosa_mm:1:autosa_mm_1\n# A and C are light (4 MB each, A panel loaded once, C written once): HBM pseudo-channels in SLR0.\nsp=autosa_mm_1.A:HBM[0]\nsp=autosa_mm_1.C:HBM[1]\n# B streams one 512-bit beat per cycle (32 MB in ~1.8 ms = 19.2 GB/s at 300 MHz). One HBM pseudo-channel peaks at\n# ~14.4 GB/s; one DDR4-2400 channel peaks at 19.2 GB/s. DDR[1] sits in SLR1, away from the HBM side in SLR0.\nsp=autosa_mm_1.B:DDR[1]\n# No SLR pinning: the kernel (~88% of the dynamic region's LUTs) must spread across all three SLRs.\n\n[vivado]\n# Kernel synthesis: routability first (the kernel is ~88% of the dynamic-region LUTs) plus global retiming\n# (FFs are at ~48%, so retiming registers are affordable).\nprop=run.__KERNEL__.STEPS.SYNTH_DESIGN.ARGS.DIRECTIVE=AlternateRoutability\nprop=run.__KERNEL__.STEPS.SYNTH_DESIGN.ARGS.GLOBAL_RETIMING=on\n# Implementation: four strategies run in parallel; v++ keeps the best result.\nimpl.strategies=Congestion_SSI_SpreadLogic_high,Performance_HighUtilSLRs,Performance_ExplorePostRoutePhysOpt,Performance_NetDelay_high\nimpl.jobs=4\nsynth.jobs=16\n"
   }
  ],
  "cwd": "/scratch/hpc-prf-llmfpga/asa582/projects/tmp/c2hls/xclbin_ladder_agent_r2_L3_63818674"
 }
}
</ENTRY>
