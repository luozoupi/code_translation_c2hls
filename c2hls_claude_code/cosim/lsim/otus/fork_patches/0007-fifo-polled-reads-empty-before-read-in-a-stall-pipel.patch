+from .frp import fifo_read_end, is_frp_function, pipeline_polls
 
 SYNC_WORK_BATCH_DURATION = 1.0
 
@@ -371,21 +371,26 @@ async def resolve_trace(
     """frp_modules: RTL module names of Vitis free-running pipelines (frp.frp_functions); their FIFO writes are timed
     from their own iteration's last read (see frp.py)."""
     builder = SimulationBuilder()
-    frp_anchor: Dict[Tuple[str, int], int | None] = {}
+    frp_anchor: Dict[Tuple[str, int], Tuple[int, bool] | None] = {}
 
-    def anchor_delta(basic_block: BasicBlock, instruction: Instruction) -> int:
+    def anchor(basic_block: BasicBlock, instruction: Instruction) -> Tuple[int, bool]:
+        """(anchor_delta, anchor_freeze) of a FIFO write: FRP pipelines and stall pipelines with polled reads"""
         pipeline = basic_block.pipeline
-        if not frp_modules or pipeline is None:
-            return 0
+        if pipeline is None:
+            return 0, False
         function = basic_block.parent
         key = (function.name, id(pipeline))
         if key not in frp_anchor:
-            frp_anchor[key] = (fifo_read_end(function, pipeline)
-                               if is_frp_function(function.name, frp_modules) else None)
-        read_end = frp_anchor[key]
-        if read_end is None or read_end < 0:
-            return 0
-        return max(0, instruction.latency.end - read_end)
+            if frp_modules and is_frp_function(function.name, frp_modules):
+                frp_anchor[key] = (fifo_read_end(function, pipeline), False)
+            elif pipeline_polls(function, pipeline):
+                frp_anchor[key] = (fifo_read_end(function, pipeline), True)
+            else:
+                frp_anchor[key] = None
+        if frp_anchor[key] is None or frp_anchor[key][0] < 0:
+            return 0, False
+        read_end, freeze = frp_anchor[key]
+        return max(0, instruction.latency.end - read_end), freeze
 
     _apply_axi_config(builder, trace.axi_latencies.keys())
     top_frame = StackFrame()
@@ -478,7 +483,7 @@ async def resolve_trace(
                             safe_offset,
