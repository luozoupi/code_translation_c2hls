 """Vitis HLS free-running pipelines (FRP, `frp_pipeline_valid` + `frp_fifoout` in the RTL).
 
-An FRP pipeline issues an iteration only when every input FIFO's num_data_valid covers the reads it has already
-requested (`ap_frp_data_req_<fifo>`) plus this one, and it reads one cycle later (stage 1). An item therefore has to be
-in the FIFO one cycle earlier than for a stall pipeline: read-after-write delay + 1 on every FIFO an FRP pipeline reads.
-Checked against Vitis 2023.2 cosim on the SODA heat3d/jacobi3d designs (10 designs, +0.003% to +0.047%).
-LSIM_FRP=0 turns it off.
+Three differences from a stall pipeline, read from sol/syn/verilog and checked against Vitis 2023.2 cosim waveforms:
+
+1. Issue: an FRP pipeline issues an iteration only when every input FIFO's num_data_valid covers the reads it has
+   requested and not done yet plus this one (`ap_frp_data_req_<fifo>`), so the item read at stage r has to be in the
+   FIFO r cycles before the read: read-after-write delay + r on that FIFO (r from `<port>_read = 1'b1` under
+   `valid_out[r]` or `ap_enable_reg_pp0_iter<r>`).
+2. Depths: Vitis may enlarge FIFOs (an FRP input with depth pragma 2 became depth 5 to keep II=1); the RTL depth, in
+   the instance's module name `<top>_fifo_w<W>_d<D>_S|A`, is the one cosim runs with.
+3. No freeze: an input that is not there holds back the next issue and leaves the iterations in flight alone, whose
+   results go through an output buffer (frp_fifoout). A write is therefore timed from its own iteration's last read
+   (anchor_delta = write stage - that read's stage, see the builder's Event::FifoWrite), not from the module's stage
+   chain, which every later read stall would push back.
+
+LSIM_FRP=0 turns all three off.
 """
 
 import os
 import re
 import sys
+from functools import lru_cache
 from pathlib import Path
-from typing import Dict, Iterable
+from typing import Dict, Iterable, Set, Tuple
+
+_FIFO_INST = re.compile(r"^\s*\w+_fifo_w(\d+)_d(\d+)_([SA])\s+(\w+)_U\s*\(", re.M)
+_INST = re.compile(r"^\s*(\w+)\s+(\w+)\s*\((.*?)\);", re.M | re.S)
+_CONN = re.compile(r"\.(\w+)\s*\(\s*([\w\[\]:']*)\s*\)")
+_READ = re.compile(r"^\s*if \(([^\n]*)\) begin\s*\n\s*(\w+)_read = 1'b1;", re.M)
+_STAGE = (re.compile(r"valid_out\[\d+'d(\d+)\]"), re.compile(r"ap_enable_reg_pp0_iter(\d+)\b"))
+
+
+def enabled() -> bool:
+    return os.environ.get("LSIM_FRP", "1") != "0"
+
+
+@lru_cache(maxsize=8)
+def analyse(solution_dir: Path):
+    """{"fifos": {RTL FIFO instance: depth}, "frp_reads": {RTL FIFO instance: r}, "frp_modules": [RTL module]}"""
+    src = {p.stem: p.read_text(errors="replace") for p in (Path(solution_dir) / "syn" / "verilog").glob("*.v")}
+    fifos = {}
+    for text in src.values():
+        for _w, d, _t, name in _FIFO_INST.findall(text):
+            fifos[name] = int(d)
+    frp_ports: Dict[str, Dict[str, int]] = {}
+    for mod, text in src.items():
+        if "frp_pipeline_valid_U" not in text:
+            continue
+        ports = {}
+        for cond, port in _READ.findall(text):
+            for rx in _STAGE:
+                m = rx.search(cond)
+                if m:
+                    ports[port] = int(m.group(1))
+                    break
+        frp_ports[mod] = ports
+    frp_reads: Dict[str, int] = {}
+    for text in src.values():
+        insts = _INST.findall(text)
+        by_read_net = {net: iname[:-2] for mtype, iname, body in insts
+                       if iname.endswith("_U") and "_fifo_w" in mtype
+                       for port, net in _CONN.findall(body) if port == "if_read"}
+        for mtype, _iname, body in insts:
+            if mtype in frp_ports:
+                conns = dict(_CONN.findall(body))
+                for port, r in frp_ports[mtype].items():
+                    net = conns.get(f"{port}_read")
+                    if net in by_read_net:
+                        frp_reads[by_read_net[net]] = r
+    return {"fifos": fifos, "frp_reads": frp_reads, "frp_modules": sorted(frp_ports)}
+
+
+def _match(lsim_name: str, rtl_names) -> str | None:
+    n = lsim_name.replace(".", "_")
+    if n in rtl_names:
+        return n
+    hits = [x for x in rtl_names if n.endswith("_" + x) or x.endswith("_" + n)]
+    return max(hits, key=len) if hits else None
+
+
+def frp_functions(solution_dir: Path) -> Set[str]:
+    """RTL module names of the FRP functions (an LSIM function f is one when a name ends with '_' + f, '.' -> '_')."""
+    if not enabled():
+        return set()
+    return set(analyse(Path(solution_dir))["frp_modules"])
+
 
-_REQ = re.compile(r"reg\s+\[\d+:0\]\s+ap_frp_data_req_(\w+?)(?<!_op\d)(?<!_op\d\d)(?<!_op\d\d\d);")
+def is_frp_function(name: str, modules: Set[str]) -> bool:
+    n = "_" + name.replace(".", "_")
+    return any(m.endswith(n) for m in modules)
 
 
-def frp_input_fifos(solution_dir: Path) -> set[str]:
-    names: set[str] = set()
-    for v in (solution_dir / "syn" / "verilog").glob("*.v"):
-        names |= set(_REQ.findall(v.read_text(errors="replace")))
-    return names
+def frp_params(solution_dir: Path, fifos: Iterable) -> Tuple[Dict[int, int], Dict[int, int]]:
+    """(read-after-write extra per FIFO id, RTL depth per FIFO id where it differs from the trace)"""
+    if not enabled():
+        return {}, {}
+    rtl = analyse(Path(solution_dir))
+    extra, depths, unmatched = {}, {}, 0
+    for f in fifos:
+        m = _match(f.name, rtl["fifos"])
+        if m is None:
+            unmatched += 1
+            continue
+        depths[f.id] = rtl["fifos"][m]
+        if m in rtl["frp_reads"] and rtl["frp_reads"][m] > 0:
+            extra[f.id] = rtl["frp_reads"][m]
+    if rtl["frp_modules"] or unmatched:
+        print(f"[lsim-frp] {len(rtl['frp_modules'])} free-running pipelines, {len(extra)} FIFOs they read "
+              f"(read-after-write + read stage), {len(depths)} RTL depths, {unmatched} FIFOs without an RTL match",
+              file=sys.stderr)
+    return extra, depths
 
 
-def frp_raw_extra(solution_dir: Path, fifos: Iterable) -> Dict[int, int]:
-    if os.environ.get("LSIM_FRP", "1") == "0":
-        return {}
-    rtl = frp_input_fifos(Path(solution_dir))
-    if not rtl:
-        return {}
-    extra = {f.id: 1 for f in fifos if any(f.name == n or f.name.endswith(n) for n in rtl)}
-    print(f"[lsim-frp] {len(extra)} FIFOs read by free-running pipelines (RTL names {len(rtl)}): read-after-write +1",
-          file=sys.stderr)
-    return extra
+def fifo_read_end(function, pipeline) -> int:
+    """Latest static stage at which `function` reads a FIFO inside `pipeline` (the FRP issue anchor)."""
+    best = -1
+    for bb in function.ordered_basic_blocks:
+        if bb.pipeline != pipeline:
+            continue
+        for ins in bb.events:
+            if ins.opcode == "read" and any(".ap_fifo" in (op.name or "") for op in ins.llvm.operands):
+                best = max(best, ins.latency.end)
+    return best
