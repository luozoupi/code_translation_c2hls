# Nibi scratch install layout (sourced by scripts/nibi/setup_vitis_env.sh).

NIBI_SCRATCH_ROOT="${NIBI_SCRATCH_ROOT:-/home/asa582/scratch/asa582}"

export C2HLS_VITIS_SETTINGS="${C2HLS_VITIS_SETTINGS:-${NIBI_SCRATCH_ROOT}/xilinx/Vitis/2023.2/settings64.sh}"
export C2HLS_XRT_SETUP="${C2HLS_XRT_SETUP:-${NIBI_SCRATCH_ROOT}/xrt/2023.2/opt/xilinx/xrt/setup.sh}"
export C2HLS_PLATFORM_REPO_PATHS="${C2HLS_PLATFORM_REPO_PATHS:-${NIBI_SCRATCH_ROOT}/platforms/u280/opt/xilinx/platforms}"
export C2HLS_OPENCL_HEADERS="${C2HLS_OPENCL_HEADERS:-${NIBI_SCRATCH_ROOT}/opencl_headers}"
export C2HLS_TMP_ROOT="${C2HLS_TMP_ROOT:-${NIBI_SCRATCH_ROOT}/tmp/c2hls}"
export C2HLS_VITIS_USER_HOME="${C2HLS_VITIS_USER_HOME:-${NIBI_SCRATCH_ROOT}/tmp/vitis_user_home}"
export C2HLS_DEVICE_PLATFORM="${C2HLS_DEVICE_PLATFORM:-xilinx_u280_gen3x16_xdma_1_202211_1}"
export C2HLS_PART="${C2HLS_PART:-xcu280-fsvh2892-2L-e}"
export C2HLS_CLOCK_NS="${C2HLS_CLOCK_NS:-3.33}"
export C2HLS_VITIS_VERSION="${C2HLS_VITIS_VERSION:-2023.2}"
export C2HLS_FLOW_TARGET="${C2HLS_FLOW_TARGET:-vitis}"
