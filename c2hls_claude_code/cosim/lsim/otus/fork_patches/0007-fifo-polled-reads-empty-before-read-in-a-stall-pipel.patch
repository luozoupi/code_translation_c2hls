     /// to the write (see [Event::FifoWrite]).
-    #[pyo3(signature = (safe_offset, stage, fifo_id, anchor_delta=0))]
+    /// `anchor_freeze`: a stall of that write freezes the pipeline (polled reads in a stall pipeline).
+    #[pyo3(signature = (safe_offset, stage, fifo_id, anchor_delta=0, anchor_freeze=false))]
     pub fn add_fifo_write(
         &mut self,
         safe_offset: SimulationStage,
         stage: SimulationStage,
         fifo_id: FifoId,
         anchor_delta: SimulationStage,
+        anchor_freeze: bool,
