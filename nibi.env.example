# SHARCNET Nibi — copy to nibi.env (gitignored) and run with --nibi or C2HLS_SITE=nibi.
#
#   cp nibi.env.example nibi.env

# --- Scratch / temp -----------------------------------------------------------
# NIBI_SCRATCH_ROOT=/home/asa582/scratch/asa582
# C2HLS_TMP_ROOT=/home/asa582/scratch/asa582/tmp/c2hls

# --- LLM / vLLM (GLM-4.7-FP8) ------------------------------------------------
# C2HLS_MODEL=glm-4.7-fp8
# GLM_MODEL_PATH=/home/asa582/scratch/asa582/workspaces/GLM-4.7-FP8
# NIBI_INFERENCE_ROOT=/home/asa582/scratch/asa582/workspaces/inference

# --- Xilinx / Vitis (standalone Apptainer SIF — recommended on Nibi) ----------
# C2HLS_USE_CONTAINER=1
# C2HLS_XILINX_SIF=/home/asa582/scratch/asa582/containers/xilinx_vitis_2023.2.standalone.sif
# NIBI_VITIS_MODULES=apptainer/1.3.5
# Or native install: C2HLS_USE_CONTAINER=0 + C2HLS_VITIS_SETTINGS=.../settings64.sh

# --- Slurm --------------------------------------------------------------------
# NIBI_SLURM_ACCOUNT=def-zhenman_gpu
# NIBI_GPU_PARTITION=gpubase_bynode_b1
# NIBI_WALLTIME=3:00:00
# NIBI_GPU_GPUS=4
# NIBI_VLLM_TENSOR_PARALLEL_SIZE=4
#
# Flash smoke:
#   ./scripts/nibi/run_flash_smoke_session.sh --dry-run
#   ./scripts/nibi/run_flash_smoke_session.sh --submit
