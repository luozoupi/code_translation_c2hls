# SHARCNET Nibi — used with --nibi or C2HLS_SITE=nibi (gitignored).

# --- Scratch / temp -----------------------------------------------------------
NIBI_SCRATCH_ROOT=/home/asa582/scratch/asa582
C2HLS_TMP_ROOT=/home/asa582/scratch/asa582/tmp/c2hls
C2HLS_VITIS_USER_HOME=/home/asa582/scratch/asa582/tmp/vitis_user_home

# --- LLM / vLLM (Devstral-2-123B on local vLLM) ------------------------------
C2HLS_MODEL=mistralai/Devstral-2-123B-Instruct-2512
NIBI_LLM_MODEL=mistralai/Devstral-2-123B-Instruct-2512
VLLM_MODEL_PATH=/home/asa582/scratch/asa582/workspaces/Devstral-2-123B-Instruct-2512
VLLM_SERVED_MODEL_NAME=mistralai/Devstral-2-123B-Instruct-2512
OPENAI_API_KEY=EMPTY
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
C2HLS_LLM_TIMEOUT=900
NIBI_INFERENCE_ROOT=/home/asa582/scratch/asa582/workspaces/inference
C2HLS_PYTHON=/home/asa582/scratch/asa582/packages/c2hls-venv/bin/python
NIBI_COMPUTE_VENV=/home/asa582/scratch/asa582/packages/c2hls-venv
NIBI_VLLM_VENV=/home/asa582/scratch/asa582/packages/c2hls-inference

# --- Xilinx / Vitis (standalone Apptainer SIF on scratch) ---------------------
C2HLS_USE_CONTAINER=1
C2HLS_XILINX_SIF=/home/asa582/scratch/asa582/containers/xilinx_vitis_2023.2.standalone.sif
NIBI_VITIS_MODULES=apptainer/1.3.5
C2HLS_PART=xcu280-fsvh2892-2L-e
C2HLS_CLOCK_NS=3.33
C2HLS_VITIS_VERSION=2023.2
C2HLS_FLOW_TARGET=vitis
C2HLS_DEVICE_PLATFORM=xilinx_u280_gen3x16_xdma_1_202211_1

# --- Nibi pilot: csynth + csim only -------------------------------------------
C2HLS_RUN_COSIM=0
C2HLS_COSIM_REQUIRED=0
C2HLS_REFERENCE_COSIM=0
C2HLS_HW_EMU_FINAL=0
C2HLS_GT_BASELINE_FALLBACK=1

# --- Slurm (Nibi H100) --------------------------------------------------------
NIBI_SLURM_ACCOUNT=def-zhenman_gpu
NIBI_COMPUTE_SLURM_ACCOUNT=def-zhenman_cpu
NIBI_GPU_PARTITION=gpubase_bygpu_b1
NIBI_WALLTIME=3:00:00
NIBI_GPU_GPUS=4
NIBI_GPU_CPUS_PER_TASK=16
NIBI_GPU_MEM=131072M
NIBI_VLLM_TENSOR_PARALLEL_SIZE=4
NIBI_GPU_MODULES="python/3.11.5 cuda/12.6"
NIBI_LLM_PORT=8000
