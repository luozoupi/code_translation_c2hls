  "hls_code": "#include \"lu.h\"\n\n\nvoid kernel_lu(\n\t       double A[ N + 0][N + 0])\n{\n#pragma HLS INLINE off\n\n    const int n = N;\n\n  int i, j, k;\n\n  for (i = 0; i < n; i++) {\n    for (j = 0; j <i; j++) {\n       for (k = 0; k < j; k++) {\n#pragma HLS PIPELINE II=1\n          A[i][j] -= A[i][k] * A[k][j];\n       }\n        A[i][j] /= A[j][j];\n    }\n   for (j = i; j < n; j++) {\n       for (k = 0; k < i; k++) {\n#pragma HLS PIPELINE II=1\n          A[i][j] -= A[i][k] * A[k][j];\n       }\n    }\n  }\n}\n\nextern \"C\" {\nvoid workload(\n\t       double A[ N + 0][N + 0])\n{\n#pragma HLS INTERFACE m_axi port=A offset=slave bundle=gmem\n#pragma HLS INTERFACE s_axilite port=A bundle=control\n#pragma HLS INTERFACE s_axilite port=return bundle=control\n\n    kernel_lu(A);\n}\n}",
