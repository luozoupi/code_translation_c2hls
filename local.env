# PC2 cluster — used with --pc2 or C2HLS_SITE=pc2 (gitignored).

# --- LLM / vLLM (gpu_h100) ---------------------------------------------------
C2HLS_MODEL=mistralai/Devstral-2-123B-Instruct-2512
PC2_LLM_MODEL=mistralai/Devstral-2-123B-Instruct-2512
# Local weights (skip HF download on GPU node if already present):
PC2_LLM_WEIGHTS=/scratch/hpc-prf-llmfpga/asa582/projects/devstral2/models/Devstral-2-123B-Instruct-2512
OPENAI_API_KEY=EMPTY
# OPENAI_BASE_URL set automatically by compute_worker from llm_endpoint.json

PC2_VLLM_VENV=/scratch/hpc-prf-llmfpga/asa582/projects/devstral2/.venv
PC2_COMPUTE_VENV=/scratch/hpc-prf-llmfpga/asa582/projects/c2hls/.venv
PC2_GPU_MODULES="lang system CUDA/12.6.0 Python/3.11.5-GCCcore-13.2.0"

# --- Xilinx / Vitis (normal node — csynth + csim only on PC2) ----------------
PC2_COMPUTE_MODULES="fpga xilinx/xrt/2.16"
PC2_COMPUTE_U280_SWAP_TO="xilinx/u280/xdma_202211_1"
# Skip cosim + hw_emu on PC2 (team server unchanged). Set to 1 to re-enable.
C2HLS_RUN_COSIM=0
C2HLS_COSIM_REQUIRED=0
C2HLS_REFERENCE_COSIM=0
C2HLS_HW_EMU_FINAL=0

# --- Slurm / supervised session (scripts/pc2/start_session.sh) ---------------
PC2_SLURM_ACCOUNT=hpc-prf-llmfpga
PC2_GPU_PARTITION=gpu_h100
PC2_COMPUTE_PARTITION=normal
PC2_WALLTIME=3:00:00

# One full gpu_h100 node: 4× H100, 48 CPUs, all node memory (mem=0)
PC2_GPU_GPUS=4
PC2_GPU_NODES=1
PC2_GPU_CPUS_PER_TASK=48
PC2_GPU_MEM=0
PC2_VLLM_TENSOR_PARALLEL_SIZE=4

# Vitis worker on normal: more CPUs/RAM for HLS + cosim on 7 benches
PC2_COMPUTE_CPUS=16
PC2_COMPUTE_MEM=128G

# Max time compute waits for vLLM health after allocation (polls every 15s).
# Not a mandatory sleep — usually ready in a few minutes after GPU starts.
PC2_COMPUTE_LLM_WAIT_SEC=1800

PC2_LLM_PORT=8000
# Optional extra vLLM CLI flags (see note below). Leave unset for defaults.
# PC2_VLLM_EXTRA_ARGS=--gpu-memory-utilization 0.90
# Replace entire vLLM launch (e.g. multi-node Ray). Leave unset to use built-in vllm serve.
# PC2_LLM_SERVE_CMD=

PC2_WORKER_CMD="python3 scripts/pc2/run_flash_noskills_batch.py --pc2"
# PC2_WORKER_CMD=python3 c2hls.py --pc2 --bench nw --multistep
