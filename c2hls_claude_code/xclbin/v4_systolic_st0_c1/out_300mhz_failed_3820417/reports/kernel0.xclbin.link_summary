  ],
  "iniFiles": [
   {
    "path": "/tmp/haqc2/3820417/xclbin_v4_systolic_st0_c1/link.cfg",
    "content": "# v++ --link config for autosa_mm (v4 systolic st0_c1, AutoSA 128 PEs, kernel0), xilinx_u280_gen3x16_xdma_1_202211_1, 300 MHz default kernel clock.\n[connectivity]\n# All three ports on separate HBM pseudo-channels (SLR0); the systolic array streams A and B through\n# IO modules, no DDR controller (no extra LUTs). Routability control for the broadcast-congestion diagnosis.\nnk=kernel0:1:kernel0_1\nsp=kernel0_1.A:HBM[0]\nsp=kernel0_1.B:HBM[1]\nsp=kernel0_1.C:HBM[2]\n# No SLR pinning: let Vivado spread the kernel across SLRs.\n\n[vivado]\n# Kernel synthesis: v++ already passes its own synth_design -directive to kernel runs, so a second DIRECTIVE\n# fails (\"'directive' can only be specified once\", attempt 1). Keep v++'s directive; add global retiming\n# (FFs are at ~48%, so retiming registers are affordable).\nprop=run.__KERNEL__.STEPS.SYNTH_DESIGN.ARGS.GLOBAL_RETIMING=on\n# Implementation: four strategies run in parallel; v++ keeps the best result.\nimpl.strategies=Congestion_SSI_SpreadLogic_high,Performance_HighUtilSLRs,Performance_ExplorePostRoutePhysOpt,Performance_NetDelay_high\nimpl.jobs=4\nsynth.jobs=16\n"
   }
  ],
  "cwd": "/tmp/haqc2/3820417/xclbin_v4_systolic_st0_c1"
 }
}
</ENTRY>
