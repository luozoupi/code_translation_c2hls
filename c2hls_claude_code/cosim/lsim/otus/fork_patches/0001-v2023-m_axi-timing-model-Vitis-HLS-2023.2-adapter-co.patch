+def _apply_axi_config(builder: SimulationBuilder, interfaces) -> None:
+    """Pass static m_axi adapter settings to the builder (v2023 AXI model).
+
+    LSIM_AXI_IFCFG names a JSON file {interface name: {read_burst_beats,
+    read_outstanding, write_burst_beats, write_outstanding, write_buffer_beats}}
+    written by the harness from the generated RTL. Interfaces without an entry
+    use the Vitis HLS 2023.2 defaults. Matched names are logged to stderr.
+    """
+    import json, os, sys
+
+    path = os.environ.get("LSIM_AXI_IFCFG")
+    config = json.load(open(path)) if path else {}
+    for interface in interfaces:
+        entry = config.get(interface.name)
+        print(
+            f"[lsim-axi] model={os.environ.get('LSIM_AXI_MODEL', 'v2021')} "
+            f"interface={interface.name} config={entry}",
+            file=sys.stderr,
+        )
+        if entry:
+            builder.set_axi_config(
+                interface.address,
+                int(entry["read_burst_beats"]),
+                int(entry["read_outstanding"]),
+                int(entry["write_burst_beats"]),
+                int(entry["write_outstanding"]),
+                int(entry["write_buffer_beats"]),
+            )
+
+
