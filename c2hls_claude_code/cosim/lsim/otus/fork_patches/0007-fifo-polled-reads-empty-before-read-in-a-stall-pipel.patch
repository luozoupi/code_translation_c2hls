@@ -41,6 +41,8 @@ pub struct StackFrame {
     pub stage_times: VecDeque<(SimulationStage, NodeTime)>,
     /// Last off-chain FRP write node per FIFO; the module ends no earlier than these.
     pub frp_writes: FxHashMap<Fifo, NodeIndex>,
+    /// Anchored writes whose stall must hold back the next stage of the chain (anchor_freeze).
+    pub freeze_writes: Vec<NodeIndex>,
 }
 
 /// How many committed stages [StackFrame::stage_times] keeps (more than any FRP pipeline depth).
@@ -57,6 +59,7 @@ impl StackFrame {
             window: VecDeque::new(),
             stage_times: VecDeque::new(),
