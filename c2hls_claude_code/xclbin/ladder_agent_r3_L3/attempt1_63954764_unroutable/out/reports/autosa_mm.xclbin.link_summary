  ],
  "iniFiles": [
   {
    "path": "/localscratch/asa582.63954764.0/xclbin_ladder_agent_r3_L3/link.cfg",
    "content": "# v++ --link config for autosa_mm (ladder_agent_r3_L3), xilinx_u280_gen3x16_xdma_1_202211_1, 300 MHz default kernel clock.\n[connectivity]\n# All three ports on separate HBM pseudo-channels (SLR0): this design needs \u003c ~6 GB/s per port, within one\n# pseudo-channel (~14.4 GB/s); no DDR controller, so no extra LUTs.\nnk=autosa_mm:1:autosa_mm_1\nsp=autosa_mm_1.A:HBM[0]\nsp=autosa_mm_1.B:HBM[1]\nsp=autosa_mm_1.C:HBM[2]\n# No SLR pinning: let Vivado spread the kernel across SLRs.\n\n[vivado]\n# Kernel synthesis: v++ already passes its own synth_design -directive to kernel runs, so a second DIRECTIVE\n# fails (\"'directive' can only be specified once\", attempt 1). Keep v++'s directive; add global retiming\n# (FFs are at ~48%, so retiming registers are affordable).\nprop=run.__KERNEL__.STEPS.SYNTH_DESIGN.ARGS.GLOBAL_RETIMING=on\n# Implementation: four strategies run in parallel; v++ keeps the best result.\nimpl.strategies=Congestion_SSI_SpreadLogic_high,Performance_HighUtilSLRs,Performance_ExplorePostRoutePhysOpt,Performance_NetDelay_high\nimpl.jobs=4\nsynth.jobs=16\n"
   }
  ],
  "cwd": "/localscratch/asa582.63954764.0/xclbin_ladder_agent_r3_L3"
 }
}
</ENTRY>
