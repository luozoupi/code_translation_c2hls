# Alliance Canada Fir — copy to fir.env (gitignored) and run with --fir or C2HLS_SITE=fir.
# Do NOT use local.env (PC2) or team API keys here. LLM serving: ../inference/
#
#   cp fir.env.example fir.env

# --- Scratch / temp -----------------------------------------------------------
# C2HLS_TMP_ROOT=/scratch/asa582/tmp/c2hls

# --- LLM / vLLM (self-hosted, mirrors PC2 Devstral setup) ---------------------
C2HLS_MODEL=mistralai/Devstral-2-123B-Instruct-2512
FIR_LLM_MODEL=mistralai/Devstral-2-123B-Instruct-2512
OPENAI_API_KEY=EMPTY
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
C2HLS_LLM_TIMEOUT=900

# Weights + venv (see ../inference/.env and scripts/load_inference_env.sh)
# FIR_INFERENCE_ROOT=/scratch/asa582/workspaces/inference
# FIR_VLLM_VENV=/path/to/venv-with-vllm

# --- Xilinx / Vitis (choose ONE: Apptainer SIF or scratch install) ------------
# Recommended on Fir: standalone SIF (protobuf + Khronos baked in)
#   source scripts/fir/fir_container_env.sh
#   bash scripts/fir/smoke_container_hls.sh
# C2HLS_XILINX_SIF=/scratch/asa582/containers/xilinx_vitis_2023.2.standalone.sif
# C2HLS_USE_CONTAINER=1
# C2HLS_VITIS_SETTINGS=/scratch/asa582/xilinx/Vitis/2023.2/settings64.sh
# C2HLS_XRT_SETUP=/scratch/asa582/xrt/2023.2/opt/xilinx/xrt/setup.sh
# C2HLS_PLATFORM_REPO_PATHS=/scratch/asa582/platforms/u280/opt/xilinx/platforms
# C2HLS_OPENCL_HEADERS=/scratch/asa582/opencl_headers
# C2HLS_VITIS_USER_HOME=/scratch/asa582/tmp/vitis_user_home
# C2HLS_PART=xcu280-fsvh2892-2L-e
# C2HLS_CLOCK_NS=3.33
# C2HLS_DEVICE_PLATFORM=xilinx_u280_gen3x16_xdma_1_202211_1

# --- Fir pilot: csynth + csim only (no cosim / hw_emu) ----------------------
# C2HLS_RUN_COSIM=0
# C2HLS_COSIM_REQUIRED=0
# C2HLS_REFERENCE_COSIM=0
# C2HLS_HW_EMU_FINAL=0

# --- Slurm (Fir H100 + CPU — adjust account/partition for your allocation) ----
# FIR_SLURM_ACCOUNT=def-zhenman_gpu
# FIR_GPU_PARTITION=gpubase_bynode_b1
# FIR_COMPUTE_PARTITION=cpubase_bynode_b1
# FIR_WALLTIME=3:00:00
# FIR_GPU_GPUS=4
# FIR_GPU_CPUS_PER_TASK=16
# FIR_GPU_MEM=128G
# FIR_COMPUTE_CPUS=8
# FIR_COMPUTE_MEM=32G
# FIR_COMPUTE_MODULES="apptainer/1.3.5"
# FIR_VLLM_TENSOR_PARALLEL_SIZE=4
# FIR_GPU_MODULES="python/3.11.5 cuda/12.6"
# FIR_LLM_PORT=8000
#
# Supervised session (GPU vLLM + Apptainer Vitis compute):
#   ./scripts/fir/run_flash_smoke_session.sh --submit
#   ./scripts/fir/start_session.sh
#   ./scripts/fir/stop_session.sh
# FIR_AUTO_STOP_ON_COMPLETE=1
# FIR_AUTO_STOP_DELAY_SEC=120
