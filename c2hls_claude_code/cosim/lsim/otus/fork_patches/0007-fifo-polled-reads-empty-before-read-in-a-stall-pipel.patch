         if let Some(frame) = self.stack.last_mut() {
             let fifo = Fifo { id: fifo_id };
             self.builders
-                .add_fifo_write(frame, safe_offset, stage, fifo, anchor_delta);
+                .add_fifo_write(frame, safe_offset, stage, fifo, anchor_delta, anchor_freeze);
         }
     }
 
@@ -287,6 +289,7 @@ impl SimulationComponentBuilders {
         stage: SimulationStage,
         fifo: Fifo,
         anchor_delta: SimulationStage,
+        anchor_freeze: bool,
     ) {
         let InsertedFifoWrite { index, raw_edge } =
             self.fifos.entry(fifo).or_default().insert_write();
@@ -304,6 +307,7 @@ impl SimulationComponentBuilders {
                 index,
                 raw_edge,
                 anchor_delta,
+                anchor_freeze,
             },
         );
     }
@@ -840,10 +844,14 @@ impl SimulationComponentBuilders {
         frame.offset += advance_by;
         let delay = advance_by.into();
         let unstalled_time = frame.current_time;
-        let stalled_time = if uncommitted_node.is_own_node() {
+        let stalled_time = if uncommitted_node.is_own_node() || !frame.freeze_writes.is_empty() {
             self.flush_axi_aw_nodes();
             let node = self.edges.insert_node();
             self.edges.push_destination(frame.current_edge);
+            for write in mem::take(&mut frame.freeze_writes) {
+                // a full output froze the pipeline: this stage comes after that write
+                self.edges.push_edge(Edge::ControlFlow(NodeWithDelay { node: write, delay: 1 }));
+            }
             let node_with_delay = NodeWithDelay { node, delay };
             frame.current_edge = self.edges.insert_edge(IncompleteEdgeType::ControlFlow);
             frame.current_time = NodeTime::Absolute(node_with_delay);
@@ -886,7 +894,7 @@ impl SimulationComponentBuilders {
             }
         }
         for (event, anchor) in frp_writes {
-            let Event::FifoWrite { fifo, .. } = event else { unreachable!() };
+            let Event::FifoWrite { fifo, anchor_freeze, .. } = event else { unreachable!() };
             self.flush_axi_aw_nodes();
             let node = self.edges.insert_node();
             self.edges.push_edge(Edge::ControlFlow(anchor));
@@ -895,6 +903,9 @@ impl SimulationComponentBuilders {
                 self.edges.push_edge(Edge::ControlFlow(NodeWithDelay { node: previous, delay: 1 }));
             }
             frame.frp_writes.insert(fifo, node);
+            if anchor_freeze {
+                frame.freeze_writes.push(node);
+            }
             self.finalize_event(frame, &event);
             self.commit_event(event, NodeWithDelay { node, delay: 0 });
         }
